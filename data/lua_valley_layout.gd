## Escada 3D renderizada (assets/props/waterfall/ladder_long.png, 64x256 —
## nativa 1x4 tiles de 64px, não vem do atlas 16px do Legend of Lua).
## Corta uma passagem caminhável através do paredão sólido, ligando o
## platô acima (linha 3) ao chão abaixo (linha 6) numa coluna que não tem
## a boca de caverna nem a queda-d'água — mesma ideia de atalho vertical de
## quando essa feature foi adicionada pro recorte 13x13 antigo, só que
## reposicionada pra coluna 11 porque a coluna antiga (5) não existe mais
## no novo recorte 26x22.
const LADDER_PATH := "res://assets/props/waterfall/ladder_long.png"
const LADDER_TILES := [
	{"x": 11, "y": 3}, {"x": 11, "y": 4}, {"x": 11, "y": 5}, {"x": 11, "y": 6},
]

static func is_ladder_tile(x: int, y: int) -> bool:
	for tile in LADDER_TILES:
		if tile["x"] == x and tile["y"] == y:
			return true
	return false

