## Célula de grama logo à frente da boca de caverna (posição REAL do mapa
## original, sem relocação) — origem da busca de spawn dos monstros.
const CAVE_MOUTH := {"x": 6, "y": 7}

static func gid(grid: Array, x: int, y: int) -> int:
	return grid[y * GRID_WIDTH + x]

static func is_blocked(x: int, y: int) -> bool:
	return BLOCKED_MASK[y * GRID_WIDTH + x] == 1

static func is_water(x: int, y: int) -> bool:
	return WATER_MASK[y * GRID_WIDTH + x] == 1

static func atlas_rect(id: int) -> Rect2i:
	var local := id - ATLAS_FIRSTGID
	var col := local % ATLAS_COLUMNS
	var row := local / ATLAS_COLUMNS
	return Rect2i(col * ATLAS_TILE_PX, row * ATLAS_TILE_PX, ATLAS_TILE_PX, ATLAS_TILE_PX)
